# Local/Hostinger server only. Never commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# auto: compatible migration mode; remote: Supabase wins on every restart;
# local: one-time recovery only, pushes SQLite to Supabase.
KRUNEST_SUPABASE_BOOTSTRAP=auto

# Hostinger's Supabase integration may provide this legacy/generic name.
# The server accepts it, but a Secret key is required for migrations and backend writes.
# SUPABASE_API_KEY=REPLACE_ME

KRUNEST_DB=./data/krunest.sqlite
KRUNEST_PLUGIN_ROOT=./data/plugins
KRUNEST_ADMIN_EMAIL=admin@example.com
KRUNEST_ADMIN_PASSWORD=replace-with-a-long-random-password
